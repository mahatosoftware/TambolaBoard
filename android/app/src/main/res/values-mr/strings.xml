    <string name="scenario_digital_title">📱 डिजिटल तिकिटे</string>
    <string name="scenario_digital_desc">खेळाडू तंबोला तिकीट ॲपमध्ये डिजिटल तिकिटे वापरतात. ते गेम आयडीने जोडले जातात आणि त्यांची तिकिटे होस्टशी सिंक राहतात.</string>
    <string name="scenario_paper_title">🎟 कागदी तिकिटे</string>
