    <string name="badge_recommended_app">"RECOMENDADO SI SE USA LA APP TAMBOLA TICKETS"</string>
    <string name="mode_moderated_title">📱 MODO MODERADO</string>
    <string name="mode_moderated_subtitle">"Usa la aplicación Tambola Tickets"</string>
    <string name="mode_moderated_desc">"Elige este modo siempre que la app Tambola Tickets sea parte de tu juego."</string>
    <string name="scenario_digital_title">📱 Billetes Digitales</string>
    <string name="scenario_digital_desc">"Los jugadores usan billetes digitales en la app Tambola Tickets. Se unen con el ID del juego y sus billetes se sincronizan con el anfitrión."</string>
    <string name="scenario_paper_title">🎟 Billetes de Papel</string>
    <string name="scenario_paper_desc">"Los jugadores usan billetes de papel mientras la app Tambola Tickets se usa para gestionar el juego."</string>
    <string name="rule_moderated_banner">"✓ Usando la app Tambola Tickets → MODO MODERADO"</string>
    <string name="btn_get_tickets_app">📲 Obtener Tambola Tickets en Google Play</string>
    <string name="mode_unmoderated_title">🎟 MODO NO MODERADO</string>
    <string name="mode_unmoderated_subtitle">El anfitrión dirige el juego</string>
    <string name="mode_unmoderated_desc">"Elige este modo cuando la app Tambola Tickets no se use para gestionar los billetes."</string>
    <string name="unmoderated_bullet_1">• El anfitrión canta los números desde Tambola Board</string>
    <string name="unmoderated_bullet_2">• Los jugadores marcan sus billetes de papel manualmente</string>
    <string name="unmoderated_bullet_3">• Los jugadores anuncian sus premios verbalmente</string>
    <string name="unmoderated_bullet_4">• El anfitrión verifica y registra los ganadores manualmente</string>
    <string name="rule_unmoderated_banner">"✓ Sin la app Tambola Tickets → MODO NO MODERADO"</string>
    <string name="step_1_title">Elegir Modo de Juego</string>
    <string name="step_2_title">Configurar Reglas y Premios</string>
    <string name="step_2_desc">Elige los patrones ganadores como Primeros 5, Línea Superior, Línea Media, Línea Inferior, Esquinas y Cartón Lleno. Asigna premios o puntos a cada regla.</string>
    <string name="step_3_title">Cantar Números</string>
    <string name="step_3_desc">Usa Llamar Siguiente para extraer números del 1 al 90 o activa Llamada Automática. Los anuncios de voz cantarán cada número.</string>
    <string name="step_4_title">Reclamar y Verificar Ganadores</string>
    <string name="step_4_desc">Cuando un jugador reclame un premio, selecciona la regla ganadora, verifica el billete y registra al ganador. En Modo Moderado, el anfitrión puede verificar billetes sincronizados directamente.</string>
    <string name="step_5_title">Ver y Compartir Ganadores</string>
    <string name="step_5_desc_mobile">Abre Ver Ganadores en cualquier momento para ver los premios reclamados y exportar un resumen en PDF para compartir.</string>
    <string name="step_5_desc_tv">Abre Ver Ganadores en cualquier momento para consultar todos los premios reclamados.</string>
