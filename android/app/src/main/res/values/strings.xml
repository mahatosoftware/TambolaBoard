    <string name="step_1_title">Choose Game Mode</string>
    <string name="step_2_title">Set Winning Rules &amp; Prizes</string>
    <string name="step_2_desc">Choose the winning patterns for your game, such as Early 5, Top Line, Middle Line, Bottom Line, Corners, and Full House. Assign prizes or points to each winning rule.</string>
    <string name="step_3_title">Call Numbers</string>
    <string name="step_3_desc">Use Call Next to draw numbers from 1 to 90, or enable Auto Call. Voice announcements will speak each called number.</string>
    <string name="step_4_title">Claim &amp; Verify Winners</string>
    <string name="step_4_desc">When a player claims a prize, select the winning pattern, verify the ticket, and record the winner. In Moderated Mode, the host can verify synchronized player tickets directly.</string>
